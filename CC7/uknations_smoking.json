{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": 400,
  "height": 400,
  "data": {
    "url": "https://raw.githubusercontent.com/lisamaina-25/lisamaina-25.github.io/refs/heads/main/CC7/smoking_nations_use.csv"
  },
  "title": {
    "text": "Smoking revalence in the UK has decreased in every nation from 2011-2025",
    "fontSize": 15.5,
    "subtitle": [
      "Share of adults over 18 self-reporting as current smokers, Source: Office of National Statistics"
    ],
    "align": "left",
    "anchor": "start"
  },
  "params": [
    {
      "name": "selected_year",
      "value": 2025,
      "bind": {
        "input": "range",
        "min": 2011,
        "max": 2025,
        "step": 1,
        "name": "Year: "
      }
    }
  ],
  "transform": [
    {"filter": "datum.year == selected_year"},
    {
      "lookup": "area_code",
      "from": {
        "data": {
          "url": "https://raw.githubusercontent.com/lisamaina-25/lisamaina-25.github.io/refs/heads/main/CC7/Countries_December_2025_Boundaries_UK_BUC_-918771479078180128.geojson",
          "format": {"property": "features"}
        },
        "key": "properties.CTRY25CD"
      },
      "as": "geo"
    }
  ],
  "projection": {"type": "mercator"},
  "mark": {"type": "geoshape", "stroke": "white"},
  "encoding": {
    "shape": {"field": "geo", "type": "geojson"},
    "color": {
      "condition": {
        "test": "!isValid(datum.current_smokers_pct)",
        "value": "#e3e3e3"
      },
      "field": "current_smokers_pct",
      "type": "quantitative",
      "title": "Current smokers (%)",
      "scale": {"scheme": "blues", "domain": [8, 24]}
    },
    "tooltip": [
      {"field": "nation", "type": "nominal", "title": "Nation"},
      {
        "field": "current_smokers_pct",
        "type": "quantitative",
        "title": "Current smokers (%)"
      }
    ]
  },
  "config": {}
}